# Chép file này thành .env.local khi chạy local, và khai báo các biến tương tự trên Vercel.

# Neon Postgres (https://neon.tech). Bỏ trống khi chạy local thì app dùng database nhúng trong .data/
DATABASE_URL=

# Mật khẩu đăng nhập web (bắt buộc trên Vercel)
APP_PASSWORD=

# Chuỗi bí mật để cron-job.org gọi /api/cron/check-prices. Tạo bằng: openssl rand -hex 24
CRON_SECRET=

# Telegram bot nhận cảnh báo (xem trang Cài đặt trong app)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL của app, VD https://dca-mate.vercel.app. Dùng để chèn link vào tin nhắn Telegram
APP_URL=

# Phí giao dịch theo công ty chứng khoán của bạn (mặc định 0,15%)
NEXT_PUBLIC_BUY_FEE_RATE=0.0015
NEXT_PUBLIC_SELL_FEE_RATE=0.0015
